main.asm:
     1                          SECTION CODE            ; No bank prefix, 16 bit ORG: default mapping
     2                          org $6000
     3                          SECTION code_user
     4                          
     5                          SECTION BANK_0          ; 16k bank 0 at $8000 (not the default page 4)
     6                          org $8000
     7                          SECTION code_bank0
     8                          
     9                          SECTION BANK_3_H        ; Upper 8k of 16k bank 3: page 7
    10                          org $E000
    11                          SECTION code_bank3h
    12                          
    13                          SECTION PAGE_21         ; 8k page 21, continues in page 22
    14                          org $C100
    15                          SECTION code_page21
    16                          
    17                          SECTION extra           ; No bank prefix, 24 bit ORG: page 20 (target zxn)
    18                          org $14C000
    19                          SECTION code_extra
    20                          
    21                          SECTION code_user
    22                          PUBLIC _main
    23                          _main:
    24                          	; Page each section in (MMU4 = $54 ... MMU7 = $57) and call its function
    25  0000  ed915400          	nextreg $54,0
    26  0004  cd0000            	call _banked
    27  0007  ed915404          	nextreg $54,4
    28  000b  ed915707          	nextreg $57,7
    29  000f  cd0000            	call _bank3h_fn
    30  0012  ed915615          	nextreg $56,21
    31  0016  ed915716          	nextreg $57,22
    32  001a  cd0000            	call _page21_fn
    33  001d  3a0220            	ld a,(_page22_data)
    34  0020  ed915614          	nextreg $56,20
    35  0024  cd0000            	call _far
    36  0027  ed915600          	nextreg $56,0
    37  002b  ed915701          	nextreg $57,1
    38  002f  c9                	ret
    39                          
    40                          SECTION code_bank0
    41                          PUBLIC _banked
    42                          _banked:
    43  0000  00                	nop
    44  0001  c9                	ret
    45                          
    46                          SECTION code_bank3h
    47                          PUBLIC _bank3h_fn
    48                          _bank3h_fn:
    49  0000  00                	nop
    50  0001  c9                	ret
    51                          
    52                          SECTION code_page21
    53                          PUBLIC _page21_fn
    54                          _page21_fn:
    55  0000  00                	nop
    56  0001  c9                	ret
    57  0002  0000000000000000  	defs $2000
