main.asm:
     1                          ; Memory map (as in a z88dk mmap.inc): a section with the bank or page in
     2                          ; its name (BANK_n, BANK_n_L/H or PAGE_n plus a suffix) and an ORG, followed
     3                          ; by the sections the code is put in. These have no bank in their name: the
     4                          ; bank is the block they are linked into (z88dk/z88dk#3197), e.g.
     5                          ;   __banked_code_head = $8000 ; const, public, def, , BANK_0_CODE,
     6                          SECTION CODE            ; No bank, 16 bit ORG: default mapping
     7                          org $6000
     8                          SECTION code_user
     9                          
    10                          SECTION BANK_0_CODE     ; 16k bank 0 at $8000 (not the default page 4)
    11                          org $8000
    12                          SECTION banked_code
    13                          
    14                          SECTION BANK_3_H_CODE   ; Upper 8k of 16k bank 3: page 7
    15                          org $E000
    16                          SECTION upper_code
    17                          
    18                          SECTION PAGE_21_CODE    ; 8k page 21, continues in page 22
    19                          org $C100
    20                          SECTION paged_code
    21                          
    22                          SECTION PAGE_20_CODE    ; 24 bit ORG: page 20 (8k, target zxn)
    23                          org $14C000
    24                          SECTION far_code
    25                          
    26                          SECTION code_user
    27                          PUBLIC _main
    28                          _main:
    29                          	; Page each section in (MMU4 = $54 ... MMU7 = $57) and call its function
    30  0000  ed915400          	nextreg $54,0
    31  0004  cd0000            	call _banked
    32  0007  ed915404          	nextreg $54,4
    33  000b  ed915707          	nextreg $57,7
    34  000f  cd0000            	call _bank3h_fn
    35  0012  ed915615          	nextreg $56,21
    36  0016  ed915716          	nextreg $57,22
    37  001a  cd0000            	call _page21_fn
    38  001d  3a0220            	ld a,(_page22_data)
    39  0020  ed915614          	nextreg $56,20
    40  0024  cd0000            	call _far
    41  0027  ed915600          	nextreg $56,0
    42  002b  ed915701          	nextreg $57,1
    43  002f  c9                	ret
    44                          
    45                          SECTION banked_code
    46                          PUBLIC _banked
    47                          _banked:
    48  0000  00                	nop
    49  0001  c9                	ret
    50                          
    51                          SECTION upper_code
    52                          PUBLIC _bank3h_fn
    53                          _bank3h_fn:
    54  0000  00                	nop
    55  0001  c9                	ret
    56                          
    57                          SECTION paged_code
    58                          PUBLIC _page21_fn
    59                          _page21_fn:
    60  0000  00                	nop
    61  0001  c9                	ret
    62  0002  0000000000000000  	defs $2000
